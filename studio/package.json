{
  "name": "tbb-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "node scripts/generer-amorce.mjs",
    "import": "node scripts/generer-amorce.mjs && sanity dataset import amorce/import.ndjson production --replace --allow-failing-assets",
    "typegen": "sanity schema extract --path=../web/sanity/schema.json && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/color-input": "latest",
    "@sanity/icons": "latest",
    "@sanity/locale-fr-fr": "latest",
    "@sanity/ui": "latest",
    "@sanity/vision": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
