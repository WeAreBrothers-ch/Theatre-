{
  "name": "tbb-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "node scripts/generer-amorce.mjs",
    "migrer": "node scripts/generer-amorce.mjs && node scripts/migrer.mjs",
    "migrer:essai": "node scripts/generer-amorce.mjs && node scripts/migrer.mjs --essai",
    "typegen": "sanity schema extract --path=../web/sanity/schema.json && sanity typegen generate",
    "test": "node --test verifications/temps.test.ts verifications/representations.test.ts verifications/communication.test.ts",
    "typecheck": "tsc --noEmit",
    "banc": "node banc/telecharger.mjs && vite --config banc/vite.config.ts"
  },
  "dependencies": {
    "@sanity/color-input": "latest",
    "@sanity/icons": "latest",
    "@sanity/locale-fr-fr": "latest",
    "@sanity/ui": "latest",
    "@sanity/vision": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
